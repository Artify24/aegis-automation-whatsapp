{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    { "source": "/(.*)", "destination": "/api/index.py?__path__=$1" }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/campaigns/followup",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/drip/trigger",
      "schedule": "0 10 * * *"
    },
    {
      "path": "/api/campaigns/reminders",
      "schedule": "0 9 * * *"
    },
    {
      "path": "/api/campaigns/winback",
      "schedule": "0 11 * * 1"
    }
  ]
}
